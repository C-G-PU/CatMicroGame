<Window x:Class="DesktopCat.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки котика" Height="300" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Разрешенные приложения (через запятую):" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="AppsTextBox" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True"
                 ToolTip="Введите имена приложений (например: Telegram, Discord, Mail). Оставьте пустым, чтобы разрешить все."/>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Размер котика:" FontWeight="Bold" Margin="0,0,0,5"/>
            <Slider x:Name="SizeSlider" Minimum="60" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True"
                    Value="120" AutoToolTipPlacement="TopLeft"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="100" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="Отмена" Width="100" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>