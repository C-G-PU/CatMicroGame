<Window x:Class="DesktopCat.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки котика" MinHeight="550" MinWidth="650" Height="550" Width="650" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" MouseDown="Window_MouseDown" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <!-- Glassmorphism стили -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#44FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#88FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Основной фон Glassmorphism -->
    <Border x:Name="MainBackgroundBorder" Background="#991A1A1A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="15" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title -->
                <RowDefinition Height="Auto"/> <!-- Tabs (Tasks/Settings) -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
            </Grid.RowDefinitions>

            <TextBlock Text="⚙ Настройки и Задачи" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <TabControl x:Name="MainTabControl" Grid.Row="2" Background="Transparent" BorderThickness="0">

                <!-- Вкладка Задач (To-Do) -->
                <TabItem Header="Мои задачи" Foreground="Black">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Визуальный календарь -->
                        <Calendar x:Name="MainCalendar" Margin="0,0,15,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#EEEEEE" SelectedDatesChanged="MainCalendar_SelectedDatesChanged"/>

                        <!-- Секция задач -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Форма добавления задачи -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBox x:Name="TaskTitleInput" Padding="5" Margin="0,0,0,5" Text="Новая задача..." Foreground="Black" GotFocus="TaskTitleInput_GotFocus"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Дата: " Foreground="White" VerticalAlignment="Center"/>
                                        <DatePicker x:Name="TaskDatePicker" Width="100" Margin="0,0,10,0"/>
                                        <TextBlock Text="Время: " Foreground="White" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TaskTimeInput" Width="40" Text="12:00" Padding="2" Margin="0,0,10,0" Foreground="Black"/>
                                        <CheckBox x:Name="TaskPermanentCheck" Content="Постоянная" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Добавить" Width="80" Click="AddTask_Click" Background="#440055FF"/>
                                </Grid>
                            </StackPanel>

                            <!-- Список задач -->
                            <ListBox x:Name="TasksList" Grid.Row="2" Background="#44FFFFFF" BorderThickness="0" Foreground="Black" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" Margin="0,0,5,0" Checked="TaskItem_Changed" Unchecked="TaskItem_Changed"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ScheduledTime, StringFormat=\{0:dd.MM HH:mm\}}" VerticalAlignment="Center" Foreground="LightGray" Margin="5,0"/>
                                            <Button Grid.Column="3" Content="✖" Width="20" Height="20" Padding="0" Background="#88AA0000" Click="DeleteTask_Click" Tag="{Binding Id}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Вкладка Настроек -->
                <TabItem Header="Внешний вид" Foreground="Black">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Idle Анимация (Спокойно):" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Добавить" Width="70" Padding="0" Click="AddCustomSkin_Click" Background="#440055FF"/>
                        </Grid>
                        <ComboBox x:Name="CatSkinCombo" Grid.Row="1" Margin="0,0,0,15" SelectionChanged="LiveUpdate_Trigger">
                            <ComboBoxItem Content="Анимация 1 (Idle)" Tag="Cat1Anim1.gif"/>
                            <ComboBoxItem Content="Sleeping Cat (cat1.png)" Tag="cat1.png"/>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Text="Active Анимация (Уведомление):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CatActiveSkinCombo" Grid.Row="3" Margin="0,0,0,15" SelectionChanged="LiveUpdate_Trigger">
                            <ComboBoxItem Content="Одинаковые (Нет)" Tag=""/>
                            <ComboBoxItem Content="Анимация 2 (Active)" Tag="Cat1Anim2.gif"/>
                            <ComboBoxItem Content="Sleeping Cat (cat1.png)" Tag="cat1.png"/>
                        </ComboBox>

                        <Grid Grid.Row="4" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Размер котика:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="В центр экрана" Width="100" Padding="2" Click="CenterCatBtn_Click" Background="#440055FF"/>
                        </Grid>
                        <Slider x:Name="SizeSlider" Grid.Row="5" Minimum="60" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True"
                                Value="150" AutoToolTipPlacement="TopLeft" Margin="0,0,0,15" ValueChanged="LiveUpdate_Trigger"/>

                        <TextBlock Grid.Row="6" Text="Длительность активной анимации (сек):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Slider x:Name="AnimationSlider" Grid.Row="7" Minimum="10" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="10" AutoToolTipPlacement="TopLeft" Margin="0,0,0,15"/>

                        <TextBlock Grid.Row="8" Text="Длительность показа уведомления (сек):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Slider x:Name="BubbleSlider" Grid.Row="9" Minimum="5" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="15" AutoToolTipPlacement="TopLeft" Margin="0,0,0,15"/>

                        <TextBlock Grid.Row="10" Text="Тема приложения:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="AppThemeCombo" Grid.Row="11" Margin="0,0,0,15" SelectionChanged="LiveUpdate_Trigger">
                            <ComboBoxItem Content="Темная (Dark Glass)" Tag="Dark"/>
                            <ComboBoxItem Content="Светлая (Light Glass)" Tag="Light"/>
                        </ComboBox>
                    </Grid>
                </TabItem>

                <!-- Вкладка Уведомлений / Облачка -->
                <TabItem Header="Уведомления" Foreground="Black">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="NotificationsCheck" Grid.Row="0" Content="Включить уведомления" Foreground="White" Margin="0,0,0,10" Checked="LiveUpdate_Trigger" Unchecked="LiveUpdate_Trigger"/>
                        <CheckBox x:Name="SoundCheck" Grid.Row="1" Content="Звуковое уведомление" Foreground="White" Margin="0,0,0,10" Checked="LiveUpdate_Trigger" Unchecked="LiveUpdate_Trigger"/>

                        <CheckBox x:Name="TestBubbleCheck" Grid.Row="2" Content="Показать облачко для настройки" Foreground="White" Margin="0,0,0,15" Checked="TestBubble_Changed" Unchecked="TestBubble_Changed"/>

                        <TextBlock Grid.Row="3" Text="Размер облачка:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Slider x:Name="CloudSizeSlider" Grid.Row="4" Minimum="100" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True"
                                Value="200" AutoToolTipPlacement="TopLeft" Margin="0,0,0,15" ValueChanged="LiveUpdate_Trigger"/>

                        <TextBlock Grid.Row="5" Text="Размер текста в облачке:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Slider x:Name="CloudTextSizeSlider" Grid.Row="6" Minimum="10" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="14" AutoToolTipPlacement="TopLeft" Margin="0,0,0,15" ValueChanged="LiveUpdate_Trigger"/>

                        <TextBlock Grid.Row="7" Text="Смещение облачка по горизонтали (X):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Slider x:Name="CloudOffsetXSlider" Grid.Row="8" Minimum="-100" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="0" AutoToolTipPlacement="TopLeft" Margin="0,0,0,15" ValueChanged="LiveUpdate_Trigger"/>

                        <TextBlock Grid.Row="9" Text="Смещение облачка по вертикали (Y):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Slider x:Name="CloudOffsetYSlider" Grid.Row="10" Minimum="-150" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="0" AutoToolTipPlacement="TopLeft" Margin="0,0,0,15" ValueChanged="LiveUpdate_Trigger"/>
                    </Grid>
                </TabItem>

                <!-- Вкладка Статистики -->
                <TabItem Header="Статистика" Foreground="Black">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <TextBlock Text="Уровень котика: " FontWeight="Bold" FontSize="18"/>
                            <TextBlock x:Name="LevelText" Text="1" FontWeight="Bold" FontSize="18" Foreground="#FFDD00"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Опыт (EXP):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ProgressBar x:Name="ExpBar" Grid.Row="2" Height="20" Minimum="0" Maximum="50" Value="0" Margin="0,0,0,15" Foreground="#FFDD00" Background="#44FFFFFF"/>
                        <TextBlock x:Name="ExpText" Grid.Row="2" Text="0 / 50" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" FontWeight="Bold"/>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Всего выполнено задач: "/>
                            <TextBlock x:Name="TotalTasksText" Text="0" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Вкладка Интеграций -->
                <TabItem Header="Интеграции" Foreground="Black">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Google Calendar API:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Grid.Row="1" Text="В разработке..." IsEnabled="False" Margin="0,0,0,5" Padding="3" Foreground="Black"/>
                        <Button Grid.Row="2" Content="Синхронизировать Google" Margin="0,0,0,15" Background="#440055FF" Click="SyncApi_Click"/>

                        <TextBlock Grid.Row="3" Text="Todoist API Token:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Grid.Row="4" Text="В разработке..." IsEnabled="False" Margin="0,0,0,5" Padding="3" Foreground="Black"/>
                    </Grid>
                </TabItem>

                <!-- Вкладка Разработчик -->
                <TabItem Header="Разработчик" Foreground="Black">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="DevModeCheck" Grid.Row="0" Content="Режим разработчика (границы окна)" Foreground="White" Margin="0,0,0,10" Checked="LiveUpdate_Trigger" Unchecked="LiveUpdate_Trigger"/>
                    </Grid>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Сохранить и закрыть" Width="150" Click="Save_Click" Background="#4400AA00"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>