<Window x:Class="DesktopCat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopCat"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        mc:Ignorable="d"
        Title="DesktopCat"
        Height="150" Width="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp">

    <!-- Главный контейнер -->
    <Border x:Name="DevModeBorder" BorderThickness="1" BorderBrush="Red" Visibility="Hidden">
    <Grid Background="Transparent">

        <!-- Картинка котика с анимацией покачивания (теперь пиксельная, без сглаживания) -->
        <!-- Добавлена поддержка GIF/Видео через gif:ImageBehavior -->
        <Image x:Name="CatSprite" gif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/cat1.png" Width="120" Height="120" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Bottom" Margin="0,0,0,10">
            <Image.RenderTransform>
                <RotateTransform x:Name="CatRotation" Angle="0"/>
            </Image.RenderTransform>
        </Image>

        <!-- Круговое меню (Radial Menu) -->
        <Popup x:Name="RadialMenuPopup" StaysOpen="True" AllowsTransparency="True" Placement="Center" PlacementTarget="{Binding ElementName=CatSprite}">
            <Grid Width="300" Height="300">
                <!-- Обертка для кнопок, чтобы располагать их по кругу -->
                <Canvas x:Name="RadialCanvas">
                    <Canvas.Resources>
                        <Style TargetType="Button" x:Key="RadialBtnStyle">
                            <Setter Property="Width" Value="50"/>
                            <Setter Property="Height" Value="50"/>
                            <Setter Property="Background" Value="#AA1A1A1A"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}"/>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EE444444"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Canvas.Resources>

                    <!-- Кнопки (позиции X/Y выставляются в коде при открытии) -->
                    <Button x:Name="BtnRadSettings" Style="{StaticResource RadialBtnStyle}" Content="⚙" FontSize="20" ToolTip="Стили и настройки" Click="RadialSettings_Click"/>
                    <Button x:Name="BtnRadCalendar" Style="{StaticResource RadialBtnStyle}" Content="📅" FontSize="20" ToolTip="Календарь и Задачи" Click="RadialCalendar_Click"/>
                    <Button x:Name="BtnRadStats"    Style="{StaticResource RadialBtnStyle}" Content="📊" FontSize="20" ToolTip="Статистика" Click="RadialStats_Click"/>
                    <Button x:Name="BtnRadNotif"    Style="{StaticResource RadialBtnStyle}" Content="🔔" FontSize="20" ToolTip="Вкл/Выкл уведомления" Click="RadialNotif_Click"/>
                    <Button x:Name="BtnRadSound"    Style="{StaticResource RadialBtnStyle}" Content="🔊" FontSize="20" ToolTip="Вкл/Выкл звук" Click="RadialSound_Click"/>
                    <Button x:Name="BtnRadExit"     Style="{StaticResource RadialBtnStyle}" Content="✖" FontSize="20" Foreground="#FF5555" ToolTip="Выход" Click="CloseBtn_Click"/>
                </Canvas>
            </Grid>
        </Popup>


        <!-- Текст уведомления (облачко) -->
        <Grid x:Name="NotificationBubble"
              Margin="0,20,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="Collapsed"
              Panel.ZIndex="10">

            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CloudScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="CloudTransform" X="0" Y="0" />
                    <TranslateTransform x:Name="CloudBobbingTransform" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Фон облачка (пиксельный GIF) -->
            <Image gif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/cloud.gif"
                   Width="200" Height="200" x:Name="CloudImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />

            <!-- Контент (текст и кнопки), слегка смещенный вверх, чтобы быть в центре самого облачка -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-15,0,0">
                <TextBlock x:Name="NotificationText" Text="Notification text" MaxWidth="150" TextWrapping="Wrap" Foreground="Black" TextAlignment="Center" Margin="5"/>

                <!-- Кнопки действия для уведомления (✔ и ✖) -->
                <StackPanel x:Name="NotificationActionPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0" Visibility="Collapsed">
                    <Button Content="✔" Width="25" Height="25" Margin="0,0,10,0" Background="#4400AA00" Foreground="White" BorderBrush="Transparent" Cursor="Hand" Click="NotifCompleteBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="✖" Width="25" Height="25" Background="#88AA0000" Foreground="White" BorderBrush="Transparent" Cursor="Hand" Click="NotifCloseBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
