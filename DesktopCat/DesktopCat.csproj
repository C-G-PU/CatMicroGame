<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <SupportedOSPlatformVersion Include="10.0.19041.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\cat.png" />
    <Resource Include="Assets\skitty.png" />
    <Resource Include="Assets\litten.png" />
    <Resource Include="Assets\sprigatito.png" />
    <Resource Include="Assets\cat1.png" />
    <Resource Include="Assets\Cat1Anim1.gif" />
    <Resource Include="Assets\Cat1Anim2.gif" />
    <Resource Include="Assets\cat1Anim3.gif" />
    <Resource Include="Assets\cloud.gif" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

</Project>
